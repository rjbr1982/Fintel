rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // פונקציית עזר שבודקת אם המשתמש הוא מנהל (רפאל)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rjbrrjbr@gmail.com' || 
        request.auth.token.email == 'freeuser.fintelapp.test@gmail.com'
      );
    }

    match /users/{userId} {
      // מנהל יכול לקרוא ולערוך את כל המשתמשים
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      match /{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
    
    match /system/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}